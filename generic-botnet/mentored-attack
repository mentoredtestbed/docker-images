#!/bin/bash

mode=$1
target=$2
iname=$3
attack_args=${@:4}

if [ -z "$mode" ]
then
    mode="nmap"
fi

mentored-registry-action -a "attack-$mode" -o /app/results/ -n "Starting attack $mode on $target using $attack_args"

target_list=$(mentored-get-ip --na-regex $target --iname $iname)

# Check if target_list is empty
if [ -z "$target_list" ]
then
    echo "No target found"
    # Use the parameter $2 as target
    target_list=$2
fi

if [ "$mode" == "nmap" ]
then
    # For each line returned by the command mentored-get-ip
    for ip in $(mentored-get-ip --na-regex $target --iname $iname)
    do
        # Execute the command nmap with the ip as argument
        nmap $attack_args $ip
    done
elif [ "$mode" == "slowloris" ]
then
    for ip in $(mentored-get-ip --na-regex $target --iname $iname)
    do
        slowloris $attack_args $ip
    done
elif [ "$mode" == "nikto" ]
then
    for ip in $(mentored-get-ip --na-regex $target --iname $iname)
    do
        nikto -host $ip $attack_args
    done
